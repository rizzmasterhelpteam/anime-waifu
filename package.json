    "test:cloud": "node tests/cloud-backend-review.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizzmasterhelpteam/anime-waifu.git"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rizzmasterhelpteam/anime-waifu/issues"
  },
  "homepage": "https://github.com/rizzmasterhelpteam/anime-waifu#readme",
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "private": true
}
