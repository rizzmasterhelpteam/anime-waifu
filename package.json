{
  "name": "anime-wifu",
  "version": "1.9.1",
  "description": "Animated browser companions with Supabase accounts, settings sync and Gemini 3.8 Live voice.",
  "main": "background.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build:auth": "esbuild shared/auth-entry.js --bundle --format=iife --global-name=WAIFU_AUTH_VENDOR --platform=browser --target=chrome110 --outfile=vendor/auth-bundle.js --minify",
    "test:cloud": "node tests/cloud-backend-review.cjs",
    "test:voice": "node tests/voice-contract.cjs",
    "test:behavior": "node tests/behavior-brain.cjs && node tests/behavior-controls.cjs && node tests/automatic-startup.cjs",
    "test:dance": "node tests/dance-playback.cjs && node tests/reference-dance.cjs",
    "test:motion": "node tests/motion-quality.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizzmasterhelpteam/anime-waifu.git"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rizzmasterhelpteam/anime-waifu/issues"
  },
  "homepage": "https://github.com/rizzmasterhelpteam/anime-waifu#readme",
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "private": true
}
