{
  "manifest_version": 3,
  "name": "Seraphina \u2014 Anime Waifu Companion",
  "version": "1.4.0",
  "description": "Animated 2D and 3D companions with natural movement, distinct character designs, tab alerts and a focus timer.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Seraphina \u2014 Anime Waifu Companion",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/tab-watcher.js",
        "content/bootstrap.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sprites/*.png",
        "assets/sprites/crimson/*.png",
        "assets/icons/*.png",
        "assets/models/*.glb",
        "assets/models/*.vrm",
        "assets/previews/*-dashboard.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
